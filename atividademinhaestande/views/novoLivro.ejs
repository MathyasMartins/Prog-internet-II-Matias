<%- include('partials/header') %>

<section class="max-w-lg mx-auto bg-white p-6 rounded-xl shadow-sm border border-slate-200">
  <form action="/livros/novo" method="POST" class="space-y-6">
    <fieldset class="space-y-4">
      <legend class="text-xl font-bold text-slate-800 border-b pb-2 w-full">Cadastrar Novo Livro</legend>

      <div class="flex flex-col gap-1">
        <label for="titulo" class="text-sm font-medium text-slate-700">Título do Livro</label>
        <input type="text" id="titulo" name="titulo" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>

      <div class="flex flex-col gap-1">
        <label for="autor" class="text-sm font-medium text-slate-700">Autor</label>
        <input type="text" id="autor" name="autor" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>

      <div class="flex flex-col gap-1">
        <label for="paginas" class="text-sm font-medium text-slate-700">Quantidade de Páginas</label>
        <input type="number" id="paginas" name="paginas" min="1" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
      </div>
    </fieldset>

    <menu class="flex justify-end gap-3 pt-2">
      <li>
        <a href="/livros" class="px-4 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-100 transition inline-block">Cancelar</a>
      </li>
      <li>
        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">Salvar Livro</button>
      </li>
    </menu>
  </form>
</section>

<%- include('partials/footer') %>